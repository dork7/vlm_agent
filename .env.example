TELEGRAM_BOT_TOKEN=
MONGODB_URI=
MONGODB_DB=voice_notes_bot
OPENROUTER_API_KEY=
# Comma-separated, in order of preference. Each is tried in turn when the one before it fails.
OPENROUTER_MODELS=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_TELEGRAM_ID=
# IANA timezone for new Users, e.g. Asia/Dubai. Defaults to UTC.
DEFAULT_TIMEZONE=
# Folder for read-only Markdown copies of each User's Tasks and Notes. Defaults to ./markdown.
MARKDOWN_DIR=
# Key the built-in Inventory API accepts, and the key the bot's Inventory tools send.
INVENTORY_API_KEY=
# Defaults to this app's own routes, http://127.0.0.1:PORT/inventory.
INVENTORY_BASE_URL=
PORT=3000
