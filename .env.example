TELEGRAM_BOT_TOKEN=
MONGODB_URI=
MONGODB_DB=voice_notes_bot
OPENROUTER_API_KEY=
# Comma-separated, in order of preference. Each is tried in turn when the one before it fails.
OPENROUTER_MODELS=openai/gpt-4o-mini,nvidia/nemotron-3.5-super-vl:free
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_TELEGRAM_ID=
# IANA timezone for new Users, e.g. Asia/Dubai. Defaults to UTC.
DEFAULT_TIMEZONE=
# Folder for read-only Markdown copies of each User's Tasks and Notes. Defaults to ./markdown.
MARKDOWN_DIR=
# Key the built-in Inventory API accepts, and the key the bot's Inventory tools send.
INVENTORY_API_KEY=
# Defaults to this app's own routes, http://127.0.0.1:PORT/inventory.
INVENTORY_BASE_URL=
# Optional: an OpenAI-compatible model server on this machine (such as LocalAI), tried last when every
# OpenRouter model fails. Its chat models are listed from GET <url>/models and tried in turn.
LOCAL_LLM_BASE_URL=http://localhost:8080/v1
# whisper.cpp model for Voice Messages. Download with:
#   curl -L -o models/ggml-small.en.bin https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-small.en.bin
WHISPER_MODEL_PATH=./models/ggml-small.en.bin
# Programs used to transcribe; default to those on the PATH (brew install ffmpeg whisper-cpp).
FFMPEG_PATH=
WHISPER_CLI_PATH=
# Optional: the Voice page, where a User talks with a voice assistant through LiveKit. Leave the three
# LIVEKIT_ variables empty to turn it off. For a local server: brew install livekit && livekit-server --dev
# (which uses the key "devkey" and secret "secret"). The voice agent runs as its own process: npm run voice-agent
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# The voice agent hears with whisper.cpp (WHISPER_MODEL_PATH above) and thinks and speaks with models on an
# OpenAI-compatible server on this machine. VOICE_BASE_URL defaults to LOCAL_LLM_BASE_URL.
VOICE_BASE_URL=
VOICE_LLM_MODEL=gemma-4-e2b-it
# Sent as reasoning_effort: none (default), minimal, low, medium or high; "omit" for servers that reject it.
VOICE_LLM_REASONING_EFFORT=
VOICE_TTS_MODEL=vits-ljs-sherpa
# The TTS model's voice ("" for its default), and the rate it speaks at in Hz (the agent says so if it's wrong).
VOICE_TTS_VOICE=
VOICE_TTS_SAMPLE_RATE=22050
# "polling" (default) or "webhook". Webhook mode needs a public https:// URL that reaches this app
# (the route is its path), and a secret Telegram sends with each update (A-Z, a-z, 0-9, _ and -).
BOT_MODE=
WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# 127.0.0.1 by default; 0.0.0.0 when the app itself must be reachable from outside.
HOST=
PORT=3000
