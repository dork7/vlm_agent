<!doctype html><html lang="en"><head><meta charset="utf-8"><%- include('style') %><title>Settings · Task assignment</title></head><body class="assign-page"><a class="skip-link" href="#main">Skip to content</a><%- include('nav', { current: '/assign/settings' }) %><main id="main"><h1>Settings</h1><% if (locals.error) { %><p class="error" role="alert"><%= error %></p><% } %><% if (locals.saved) { %><p class="notice" role="status">Password changed. Your other devices were signed out.</p><% } %><section><h2>Password</h2><form method="post" action="/assign/settings/password"><div class="field"><label for="settings-password">New password</label><small class="hint" id="settings-password-hint">At least 10 characters. Changing it signs you out on other devices.</small><input id="settings-password" type="password" name="password" minlength="10" autocomplete="new-password" aria-describedby="settings-password-hint" required<% if (locals.error) { %> aria-invalid="true" autofocus<% } %>></div><button>Change password</button></form></section><section><h2>Sessions</h2><form method="post" action="/assign/logout"><p class="hint">Sign out on this device only.</p><button>Sign out here</button></form><form method="post" action="/assign/logout-all"><p class="hint">Sign out on every device, including this one.</p><button class="danger">Sign out everywhere</button></form></section></main></body></html>
