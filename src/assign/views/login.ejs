<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <%- include('style') %>
  <title>Log in · Task assignment</title>
</head>
<body class="auth-page auth-login-page">
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="auth-layout">
    <div class="auth-hero">
      <a class="auth-brand" href="/assign/login"><span class="brand-mark">TA</span> Task assignment</a>
      <p class="eyebrow">One place for every job</p>
      <p class="hero-title">Less chasing.<br>More done.</p>
      <p>Make a list, share one link, and see progress as it happens.</p>
    </div>
    <main id="main" class="auth-card">
      <h1>Task assignment</h1>
      <% if (locals.error) { %><p class="error" role="alert"><%= error %></p><% } %>
      <form method="post" action="/assign/login">
        <h2>Log in with email</h2>
        <p class="hint">We'll email you a one-time login link. No password needed.</p>
        <div class="field">
          <label for="login-email">Email</label>
          <input id="login-email" type="email" name="email" autocomplete="email" maxlength="254" value="<%= locals.mode === 'link' ? (locals.email || '') : '' %>" required<% if (locals.error && locals.mode === 'link') { %> aria-invalid="true" autofocus<% } %>>
        </div>
        <button>Send login link</button>
      </form>
      <form method="post" action="/assign/password-login">
        <h2>Or use a password</h2>
        <p class="hint">Only works if you set a password after logging in with a link.</p>
        <div class="field">
          <label for="password-email">Email</label>
          <input id="password-email" type="email" name="email" autocomplete="username" maxlength="254" value="<%= locals.mode === 'password' ? (locals.email || '') : '' %>" required>
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input id="password" type="password" name="password" autocomplete="current-password" required<% if (locals.error && locals.mode === 'password') { %> aria-invalid="true" autofocus<% } %>>
        </div>
        <button>Log in</button>
      </form>
    </main>
  </div>
</body>
</html>
