<style>
  :root {
    color-scheme: dark;
    --bg: #11151c;
    --surface-1: #1b222c;
    --surface-2: #252e3a;
    --surface-3: #303b49;
    --text: #e0e5eb;
    --muted: #aeb9c7;
    --border: rgb(230 237 246 / 13%);
    --accent: #a9bce4;
    --accent-hover: #c1d0ef;
    --accent-surface: #29384f;
    --danger: #efa3aa;
    --danger-surface: #422a34;
    --focus: #d2b97e;
  }
  :root[data-theme="light"] {
    color-scheme: light;
    --bg: #f3f5f8;
    --surface-1: #fff;
    --surface-2: #edf1f6;
    --surface-3: #e2e8f0;
    --text: #253041;
    --muted: #526176;
    --border: rgb(32 48 70 / 16%);
    --accent: #345b9c;
    --accent-hover: #24457c;
    --accent-surface: #e4ecfa;
    --danger: #a22e43;
    --danger-surface: #fae7ea;
    --focus: #815a1f;
  }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme="dark"]) {
      color-scheme: light;
      --bg: #f3f5f8;
      --surface-1: #fff;
      --surface-2: #edf1f6;
      --surface-3: #e2e8f0;
      --text: #253041;
      --muted: #526176;
      --border: rgb(32 48 70 / 16%);
      --accent: #345b9c;
      --accent-hover: #24457c;
      --accent-surface: #e4ecfa;
      --danger: #a22e43;
      --danger-surface: #fae7ea;
      --focus: #815a1f;
    }
  }
  * { box-sizing: border-box; }
  html { background: var(--bg); }
  body {
    max-width: 68rem;
    margin: 0 auto;
    padding: 3.25rem clamp(1rem, 4vw, 2.5rem) 5rem;
    background: var(--bg);
    color: var(--text);
    font: 1rem/1.6 system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    transition: background-color .2s ease, color .2s ease;
  }
  body.auth-page { max-width: 38rem; }
  h1, h2, h3 { line-height: 1.25; letter-spacing: -.025em; }
  h1 { margin: 1.2rem 0 1.5rem; font-size: clamp(1.8rem, 4vw, 2.5rem); }
  h2 { margin: 0 0 1rem; font-size: 1.25rem; }
  h3 { margin: .25rem 0 .7rem; font-size: 1.1rem; }
  p { margin: .65rem 0 1rem; }
  a { color: var(--accent); text-decoration-thickness: .08em; text-underline-offset: .18em; }
  a:hover { color: var(--accent-hover); }
  nav { display: flex; flex-wrap: wrap; gap: .35rem .7rem; padding: .6rem 0 1.1rem; border-bottom: 1px solid var(--border); }
  nav a { display: inline-block; padding: .4rem .7rem; border-radius: .5rem; text-decoration: none; }
  nav a:hover { background: var(--surface-2); }
  section, article, body.auth-page form {
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: .85rem;
    padding: clamp(1rem, 2vw, 1.4rem);
    margin: 1rem 0;
  }
  section article, article article { background: var(--surface-2); }
  form { margin: .8rem 0; }
  label { display: inline-flex; align-items: center; gap: .45rem; margin: .35rem .6rem .35rem 0; }
  input:not([type="checkbox"]), textarea, select {
    width: min(100%, 32rem);
    min-height: 2.6rem;
    padding: .55rem .72rem;
    margin: .2rem .45rem .2rem 0;
    border: 1px solid var(--border);
    border-radius: .5rem;
    background: var(--surface-2);
    color: var(--text);
    font: inherit;
  }
  textarea { display: block; min-height: 5.5rem; resize: vertical; }
  input::placeholder, textarea::placeholder { color: var(--muted); opacity: 1; }
  input[type="checkbox"] { accent-color: var(--accent); width: 1.1rem; height: 1.1rem; }
  button {
    min-height: 2.6rem;
    padding: .55rem .9rem;
    margin: .2rem .4rem .2rem 0;
    border: 1px solid var(--border);
    border-radius: .5rem;
    background: var(--accent-surface);
    color: var(--text);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition: background-color .2s ease, border-color .2s ease;
  }
  button:hover { background: var(--surface-3); border-color: var(--accent); }
  button:disabled { opacity: .55; cursor: not-allowed; }
  :where(a, button, input, textarea, select, summary):focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }
  .muted, time { color: var(--muted); }
  .blocked { color: var(--danger); }
  article:has(.blocked) { border-color: var(--danger); background: var(--danger-surface); }
  .done { color: var(--muted); }
  details { padding: 1rem; margin: 1rem 0; background: var(--surface-1); border: 1px solid var(--border); border-radius: .85rem; }
  summary { cursor: pointer; font-weight: 600; }
  aside[role="alert"] { padding: .9rem 1rem; margin: .7rem 0; border: 1px solid var(--accent); border-radius: .6rem; background: var(--accent-surface); }
  .skip-link { position: absolute; left: 1rem; top: -4rem; z-index: 20; padding: .5rem .85rem; border-radius: .5rem; background: var(--surface-3); color: var(--text); font-weight: 600; }
  .skip-link:focus { top: .65rem; }
  nav a[aria-current="page"] { background: var(--accent-surface); color: var(--text); font-weight: 600; }
  main > h1 + .back, .back { display: inline-block; margin: -.75rem 0 .5rem; }
  .field { display: grid; gap: .3rem; margin: .8rem 0; }
  .field[hidden] { display: none; }
  .field label { display: block; margin: 0; font-weight: 600; }
  .field input, .field textarea, .field select { margin: 0; }
  .hint { color: var(--muted); font-size: .875rem; font-weight: 400; }
  .filters { display: flex; flex-wrap: wrap; align-items: end; gap: .25rem 1rem; }
  .filters .field { margin: .3rem 0; }
  .field > * { min-width: 0; }
  .filters .field input, .filters .field select { width: auto; min-width: 11rem; height: 2.6rem; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: .25rem .75rem; margin-top: .6rem; }
  fieldset { margin: .8rem 0; padding: .6rem 1rem .8rem; border: 1px solid var(--border); border-radius: .6rem; }
  legend { padding: 0 .35rem; font-weight: 600; }
  fieldset label { display: flex; margin: .3rem 0; }
  fieldset label:has(input:disabled) { color: var(--muted); }
  .badge { display: inline-block; padding: 0 .55rem; margin: 0 .25rem; border: 1px solid var(--border); border-radius: 999px; background: var(--surface-3); font-size: .8rem; font-weight: 600; line-height: 1.6; vertical-align: .1em; }
  .badge.blocked { border-color: var(--danger); }
  .badge.new { border-color: var(--accent); background: var(--accent-surface); }
  .empty { color: var(--muted); }
  .instruction { white-space: pre-wrap; }
  .task-lines { margin: .5rem 0 0; padding-left: 1.2rem; }
  .row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .25rem .75rem; }
  .row form { margin: 0; }
  .task-toolbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .75rem; margin: 1.25rem 0 1rem; }
  .task-toolbar h2 { margin: 0; }
  .view-toggle { display: inline-flex; gap: .25rem; }
  .view-toggle[hidden] { display: none; }
  .view-toggle button { margin: 0; background: transparent; }
  .view-toggle button[aria-pressed="true"] { background: var(--accent-surface); border-color: var(--accent); }
  .task-collection { display: grid; gap: .75rem; }
  .task-collection article { margin: 0; min-width: 0; overflow-wrap: anywhere; }
  .task-collection[data-view="list"] article { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .35rem 1rem; }
  .task-collection[data-view="grid"] { grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr)); }
  .task-heading { min-width: 0; }
  .task-meta { display: flex; flex-wrap: wrap; gap: .25rem 1rem; font-size: .875rem; }
  .task-meta:empty { display: none; }
  .task-collection[data-view="grid"] .task-meta { margin-top: .65rem; }
  button.danger { background: var(--danger-surface); border-color: var(--danger); color: var(--danger); }
  button.danger:hover { background: var(--danger-surface); border-color: var(--danger); filter: brightness(1.12); }
  button.secondary { background: transparent; }
  .error { padding: .9rem 1rem; margin: .7rem 0; border: 1px solid var(--danger); border-radius: .6rem; background: var(--danger-surface); color: var(--text); }
  aside[role="status"]:not(.sr-only), p[role="status"]:not(:empty).notice { padding: .9rem 1rem; margin: .7rem 0; border: 1px solid var(--accent); border-radius: .6rem; background: var(--accent-surface); }
  .copy-row { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem; }
  .copy-row input { flex: 1 1 16rem; margin: 0; }
  dialog { width: min(30rem, calc(100vw - 2rem)); padding: clamp(1.1rem, 3vw, 1.5rem); border: 1px solid var(--border); border-radius: .85rem; background: var(--surface-1); color: var(--text); box-shadow: 0 1.5rem 3rem rgb(0 0 0 / 35%); }
  dialog::backdrop { background: rgb(8 11 16 / 60%); }
  dialog h2 { margin-top: 0; }
  dialog form { margin: 1rem 0 0; }
  .theme-toggle { position: absolute; top: .65rem; right: .8rem; z-index: 10; background: var(--surface-3); font-size: .85rem; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @media (max-width: 42rem) { body { padding-top: 3.5rem; } nav { gap: .1rem; } nav a { padding: .35rem .5rem; } }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition-duration: .01ms !important; } }
</style>
<script>
  (() => {
    const key = "ta-theme";
    let choice = "auto";
    try { const saved = localStorage.getItem(key); if (saved === "dark" || saved === "light") choice = saved; } catch {}
    if (choice !== "auto") document.documentElement.dataset.theme = choice;
    document.addEventListener("DOMContentLoaded", () => {
      const button = document.createElement("button");
      const announcement = document.createElement("span");
      button.type = "button";
      button.className = "theme-toggle";
      announcement.className = "sr-only";
      announcement.setAttribute("role", "status");
      announcement.setAttribute("aria-live", "polite");
      const update = () => {
        const mode = choice === "auto" ? "System" : choice === "dark" ? "Dark" : "Light";
        button.textContent = `Appearance: ${mode}`;
        button.setAttribute("aria-label", `Appearance: ${mode}. Change theme`);
        announcement.textContent = `Appearance set to ${mode}`;
      };
      button.addEventListener("click", () => {
        choice = choice === "auto" ? "dark" : choice === "dark" ? "light" : "auto";
        if (choice === "auto") delete document.documentElement.dataset.theme;
        else document.documentElement.dataset.theme = choice;
        try { if (choice === "auto") localStorage.removeItem(key); else localStorage.setItem(key, choice); } catch {}
        update();
      });
      update();
      const skip = document.querySelector(".skip-link");
      if (skip) skip.after(announcement, button); else document.body.prepend(announcement, button);
    });
  })();
</script>
