<!doctype html><html lang="en"><head><meta charset="utf-8"><%- include('style') %><title>Set a password? · Task assignment</title></head><body class="auth-page"><a class="skip-link" href="#main">Skip to content</a><main id="main"><h1>Set a password?</h1><% if (locals.error) { %><p class="error" role="alert"><%= error %></p><% } %><form method="post" action="/assign/password-offer"><p>A password lets you log in without waiting for an email. You can always use email links instead, and add a password later in Settings.</p><div class="field"><label for="new-password">Password <span class="hint">(optional)</span></label><small class="hint" id="new-password-hint">At least 10 characters.</small><input id="new-password" type="password" name="password" minlength="10" autocomplete="new-password" aria-describedby="new-password-hint"<% if (locals.error) { %> aria-invalid="true" autofocus<% } %>></div><div class="actions"><button>Set password</button><button type="submit" name="skip" value="1" class="secondary" formnovalidate>Skip for now</button></div></form></main></body></html>
