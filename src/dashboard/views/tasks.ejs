<%- include("header", { title: "Tasks" }) %>
<%- include("page-heading", { title: "Tasks", description: "A clear view of what needs doing.", count: tasks.length, countLabel: tab === "open" ? "open tasks" : "completed tasks" }) %>
<p class="tabs">
  <a href="/tasks"<% if (tab === "open") { %> aria-current="page"<% } %>>Open</a>
  <a href="/tasks?tab=done"<% if (tab === "done") { %> aria-current="page"<% } %>>Done</a>
</p>
<% if (tasks.length === 0) { %>
  <%- include("empty-state", {
    message: `No ${tab} Tasks.`,
    hint: tab === "open" ? "Send the bot a message to capture your next task." : "Tasks you mark done will appear here.",
    href: tab === "done" ? "/tasks" : "/notes",
    action: tab === "done" ? "View open tasks" : "Browse your notes"
  }) %>
<% } else { %>
  <ul class="tasks">
  <% for (const task of tasks) { %>
    <li>
      <div class="item-main">
        <a class="task-heading" href="/tasks/<%= task._id %>"><strong><%= task.heading %></strong></a>
        <div class="meta"><%= due(task.due) ? `Due ${due(task.due)}` : "No due date" %></div>
        <pre><%= task.description %></pre>
        <details>
          <summary>Original Transcript</summary>
          <pre><%= task.transcript %></pre>
        </details>
      </div>
      <div class="item-actions">
        <% if (task.status === "open") { %>
          <form class="inline" method="post" action="/tasks/<%= task._id %>/done"><button type="submit">Mark done</button></form>
        <% } else { %>
          <form class="inline" method="post" action="/tasks/<%= task._id %>/reopen"><button type="submit">Reopen</button></form>
        <% } %>
        <a href="/tasks/<%= task._id %>">Edit</a>
      </div>
    </li>
  <% } %>
  </ul>
<% } %>
<%- include("footer") %>
