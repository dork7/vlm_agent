<%- include("header", { title: "Run totals" }) %>
<p><a href="/runs">&larr; All Runs</a></p>
<h1>Run totals</h1>

<h2>Health</h2>
<table>
  <tr><th>Failure rate</th><td><%= share(failed, finished) %></td></tr>
  <tr><th>Fallback</th><td><%= share(fellBack, usedModel) %></td></tr>
</table>
<p class="meta">Failure rate counts finished Runs. Fallback counts Runs that called a model, where a model failed and the next in the list was tried.</p>

<h2>By type</h2>
<table>
<% for (const [type, label] of types) { %>
  <tr><th><%= label %></th><td><%= byType[type] ?? 0 %></td></tr>
<% } %>
</table>

<h2>Average time per stage</h2>
<% if (averageStageMs.length === 0) { %>
  <p>No stages recorded yet.</p>
<% } else { %>
  <table>
  <% for (const stage of averageStageMs) { %>
    <tr><th><%= stage.name %></th><td><%= duration(stage.averageMs) %></td></tr>
  <% } %>
  </table>
<% } %>

<h2>Messages per day</h2>
<% if (perDay.length === 0) { %>
  <p>No messages yet.</p>
<% } else { %>
  <table>
  <% for (const { date, count } of perDay) { %>
    <tr><th><%= day(date) %></th><td><%= count %></td></tr>
  <% } %>
  </table>
<% } %>
<%- include("footer") %>
