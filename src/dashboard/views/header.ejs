<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Voice Notes Bot</title>
  <script>
    // Apply a saved manual theme before first paint, so the page never flashes the wrong one.
    try { var t = localStorage.getItem("theme"); if (t === "light" || t === "dark") document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
  <style>
    /* Semantic tokens. Light is the base palette; dark redefines each token. */
    :root {
      color-scheme: light;
      --bg: #f6f6f8;
      --surface-1: #ffffff;   /* cards, tables, nav */
      --surface-2: #f0f0f3;   /* inputs, code blocks inside cards */
      --surface-3: #e6e6eb;   /* hover, pressed */
      --text: #1c1c1f;
      --text-muted: #5c5c66;
      --border: rgba(0, 0, 0, .10);
      --border-strong: rgba(0, 0, 0, .22);
      --accent: #2f5bd3;
      --accent-text: #ffffff;
      --accent-soft: rgba(47, 91, 211, .10);
      --danger: #b00020;
      --danger-soft: rgba(176, 0, 32, .08);
      --warning: #6b4e00;
      --warning-soft: #fff3c4;
      --success: #1d6b31;
      --success-soft: rgba(29, 107, 49, .10);
      --neutral-soft: rgba(0, 0, 0, .06);
      --focus: #2f5bd3;
      --shadow: 0 1px 2px rgba(0, 0, 0, .06);
    }
    /* Dark: elevation through lighter surfaces (no shadows), off-white text,
       desaturated accent and status colours, low-opacity white borders. */
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) {
        color-scheme: dark;
        --bg: #121212;
        --surface-1: #1c1c1e;
        --surface-2: #252528;
        --surface-3: #2f2f33;
        --text: #e0e0e0;
        --text-muted: #a3a3ab;
        --border: rgba(255, 255, 255, .08);
        --border-strong: rgba(255, 255, 255, .18);
        --accent: #8fa7e6;
        --accent-text: #121212;
        --accent-soft: rgba(143, 167, 230, .14);
        --danger: #ef9a9f;
        --danger-soft: rgba(239, 154, 159, .12);
        --warning: #e9cd85;
        --warning-soft: rgba(233, 205, 133, .14);
        --success: #8fcf9e;
        --success-soft: rgba(143, 207, 158, .12);
        --neutral-soft: rgba(255, 255, 255, .07);
        --focus: #8fa7e6;
        --shadow: none;
      }
    }
    :root[data-theme="dark"] {
      color-scheme: dark;
      --bg: #121212;
      --surface-1: #1c1c1e;
      --surface-2: #252528;
      --surface-3: #2f2f33;
      --text: #e0e0e0;
      --text-muted: #a3a3ab;
      --border: rgba(255, 255, 255, .08);
      --border-strong: rgba(255, 255, 255, .18);
      --accent: #8fa7e6;
      --accent-text: #121212;
      --accent-soft: rgba(143, 167, 230, .14);
      --danger: #ef9a9f;
      --danger-soft: rgba(239, 154, 159, .12);
      --warning: #e9cd85;
      --warning-soft: rgba(233, 205, 133, .14);
      --success: #8fcf9e;
      --success-soft: rgba(143, 207, 158, .12);
      --neutral-soft: rgba(255, 255, 255, .07);
      --focus: #8fa7e6;
      --shadow: none;
    }

    *, *::before, *::after { box-sizing: border-box; }
    html { background: var(--bg); }
    body {
      font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
      background: var(--bg); color: var(--text);
      max-width: 56rem; margin: 0 auto; padding: 0 1rem 3rem; line-height: 1.55;
    }
    body, nav, pre, input, textarea, select, button, ul.notes li, ul.tasks li, table, details, .status {
      transition: background-color .2s ease, color .2s ease, border-color .2s ease;
    }
    @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }

    a { color: var(--accent); text-underline-offset: .15em; }
    a:hover { text-decoration-thickness: 2px; }
    :focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; border-radius: 4px; }
    h1 { font-size: 1.6rem; line-height: 1.25; margin: 1.5rem 0 .5rem; }
    h2 { font-size: 1.1rem; margin: 2rem 0 .5rem; }
    .meta { color: var(--text-muted); font-size: .875rem; }
    code { font-size: .875em; background: var(--surface-2); padding: .1em .35em; border-radius: 4px; }

    /* Top bar */
    nav {
      position: sticky; top: 0; z-index: 1;
      display: flex; align-items: center; gap: .25rem; flex-wrap: wrap;
      margin: 0 -1rem 1rem; padding: .5rem 1rem;
      /* Paint the bar edge to edge of the window while its content stays in the column. */
      border-image: linear-gradient(to bottom, var(--surface-1) calc(100% - 1px), var(--border-strong) 0) fill 0 // 0 100vmax;
    }
    nav a { color: var(--text); text-decoration: none; padding: .35rem .7rem; border-radius: 6px; font-weight: 500; }
    nav a:hover { background: var(--surface-3); }
    nav a[aria-current] { background: var(--accent-soft); color: var(--accent); }
    nav .theme-toggle { margin-left: auto; }

    /* Tabs */
    .tabs { display: inline-flex; gap: .25rem; padding: .25rem; background: var(--surface-1); border: 1px solid var(--border); border-radius: 8px; }
    .tabs a { margin: 0; padding: .3rem .9rem; border-radius: 6px; color: var(--text-muted); text-decoration: none; font-weight: 500; }
    .tabs a:hover { background: var(--surface-3); color: var(--text); }
    .tabs a[aria-current] { background: var(--surface-3); color: var(--text); font-weight: 700; }

    /* Lists as cards (surface 1), with their code blocks one level up (surface 2) */
    ul.notes, ul.tasks { list-style: none; padding: 0; display: grid; gap: .6rem; }
    ul.notes li, ul.tasks li {
      background: var(--surface-1); border: 1px solid var(--border); border-radius: 10px;
      padding: .85rem 1rem; box-shadow: var(--shadow);
    }
    ul.tasks li > a strong { font-size: 1.05rem; }
    pre {
      white-space: pre-wrap; word-break: break-word; font-size: .9rem;
      background: var(--surface-2); border: 1px solid var(--border); border-radius: 8px; padding: .75rem;
    }
    body > pre { background: var(--surface-1); }
    details { margin: .5rem 0; }
    summary { cursor: pointer; color: var(--text-muted); font-size: .875rem; }
    summary:hover { color: var(--text); }

    /* Forms */
    label { display: block; margin-top: .9rem; margin-bottom: .25rem; font-weight: 600; font-size: .9rem; }
    label:has(input[type=checkbox]) { display: flex; align-items: center; gap: .5rem; font-weight: 500; }
    input[type=text], input[type=search], input[type=password], input[type=date], input[type=time], textarea, select {
      width: 100%; font: inherit; color: var(--text);
      background: var(--surface-2); border: 1px solid var(--border-strong); border-radius: 8px; padding: .5rem .65rem;
    }
    input[type=date], input[type=time], select { width: auto; min-width: 12rem; }
    input::placeholder, textarea::placeholder { color: var(--text-muted); }
    input:focus, textarea:focus, select:focus { outline: 2px solid var(--focus); outline-offset: 0; border-color: transparent; }
    input[type=checkbox] { accent-color: var(--accent); width: 1rem; height: 1rem; }
    form[role=search] { display: flex; gap: .5rem; align-items: center; margin-bottom: 1rem; }
    form[role=search] input { flex: 1; }
    form.inline { display: inline; }
    form + form { margin-top: .5rem; }

    button {
      font: inherit; font-weight: 600; font-size: .9rem; cursor: pointer;
      color: var(--accent-text); background: var(--accent);
      border: 1px solid transparent; border-radius: 8px; padding: .45rem .9rem;
    }
    button:hover { filter: brightness(1.08); }
    /* Secondary actions: inline buttons inside list items, and the theme switch */
    form.inline button, .theme-toggle {
      color: var(--text); background: var(--surface-2); border-color: var(--border-strong);
      padding: .3rem .7rem; font-size: .85rem;
    }
    form.inline button:hover, .theme-toggle:hover { background: var(--surface-3); filter: none; }
    /* Destructive actions */
    form[action$="/delete"] button, form[action$="/remove"] button {
      color: var(--danger); background: var(--danger-soft); border-color: var(--danger);
    }
    form[action$="/delete"] button:hover, form[action$="/remove"] button:hover { filter: none; background: var(--danger); color: var(--bg); }

    /* Tables */
    table {
      border-collapse: separate; border-spacing: 0; width: 100%;
      background: var(--surface-1); border: 1px solid var(--border); border-radius: 10px; overflow: hidden;
      font-size: .9rem;
    }
    th, td { text-align: left; padding: .5rem .75rem; border-bottom: 1px solid var(--border); vertical-align: top; }
    tr:last-child > th, tr:last-child > td { border-bottom: 0; }
    thead th { background: var(--surface-2); color: var(--text-muted); font-weight: 600; font-size: .8rem; text-transform: uppercase; letter-spacing: .04em; }
    tbody tr:hover { background: var(--neutral-soft); }
    td table { background: var(--surface-2); margin-top: .25rem; }
    td table thead th { background: var(--surface-3); }
    @media (max-width: 40rem) { table { display: block; overflow-x: auto; } }

    /* Status: badges where it is a label, coloured text where it marks a cell */
    .status { display: inline-block; font-weight: 600; font-size: .8rem; padding: .1rem .55rem; border-radius: 999px; background: var(--neutral-soft); color: var(--text-muted); vertical-align: middle; }
    h1 .status { font-size: .9rem; }
    .status-failed { color: var(--danger); }
    .status-succeeded { color: var(--success); }
    .status.status-failed { background: var(--danger-soft); }
    .status.status-succeeded { background: var(--success-soft); }
    .status.status-awaiting-clarification, .status-awaiting-clarification { background: var(--warning-soft); color: var(--warning); }
    .status-refused, .status-in-progress { color: var(--text-muted); }
    tr[class^="status-"] { color: inherit; background: none; }
    p.status-failed { background: var(--danger-soft); border: 1px solid var(--danger); border-radius: 8px; padding: .65rem .8rem; }
  </style>
</head>
<body>
<nav aria-label="Main">
  <a href="/tasks">Tasks</a><a href="/notes">Notes</a><% if (locals.viewer?.isAdmin) { %><a href="/runs">Runs</a><a href="/users">Users</a><% } %>
  <button type="button" class="theme-toggle" id="theme-toggle">Theme: Auto</button>
</nav>
<script>
  (function () {
    // Mark the current section in the top bar.
    var section = "/" + location.pathname.split("/")[1];
    document.querySelectorAll("nav a").forEach(function (a) { if (a.getAttribute("href") === section) a.setAttribute("aria-current", "page"); });

    // Manual theme switch alongside the system setting: Auto → Dark → Light → Auto.
    var root = document.documentElement, button = document.getElementById("theme-toggle");
    var names = { auto: "Auto", dark: "Dark", light: "Light" };
    function current() { return root.dataset.theme || "auto"; }
    function show() { button.textContent = "Theme: " + names[current()]; }
    button.addEventListener("click", function () {
      var next = { auto: "dark", dark: "light", light: "auto" }[current()];
      if (next === "auto") delete root.dataset.theme; else root.dataset.theme = next;
      try { if (next === "auto") localStorage.removeItem("theme"); else localStorage.setItem("theme", next); } catch (e) {}
      show();
    });
    show();
  })();
</script>
